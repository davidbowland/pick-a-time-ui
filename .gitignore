# Node artifact files
# No trailing slash on node_modules: parallel-agent worktrees symlink it rather
# than reinstalling, and a trailing slash only matches directories, so `git add -A`
# in a worktree would stage the symlink.
node_modules
dist/
coverage/

# Next.js
out/
.next/
.swc/

# AWS SAM
.aws-sam/

# Generated artifacts. next-sitemap writes these to out/ (already ignored above); the public/
# entries stay as a guard in case it is ever run without next-sitemap.config.js's outDir.
public/sitemap*.xml
public/robots.txt

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Agent, editor, and incremental-build scratch
.claude/
.superpowers/
.vscode
.worktrees/
docs/
tsconfig.tsbuildinfo
